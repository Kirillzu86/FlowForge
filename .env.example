# FlowForge Environment Variables Configuration

# Django Core
SECRET_KEY=generate-a-strong-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,flowforge.yourdomain.com

# PostgreSQL Database
POSTGRES_DB=flowforge
POSTGRES_USER=flowforge_user
POSTGRES_PASSWORD=flowforge_strong_password
DATABASE_URL=postgres://flowforge_user:flowforge_strong_password@localhost:5432/flowforge

# Redis & Celery
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://localhost:6379/0

# Encryption (Fernet 32-byte urlsafe base64 key, or leave blank to derive from SECRET_KEY)
ENCRYPTION_KEY=

# AI Model Providers (Optional default system keys)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
